{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "declaration": true,
    "declarationMap": true,
    "experimentalDecorators": false,
    "skipLibCheck": true,
    "types": ["node"],
    "paths": {
      "@perishlab/locus": ["./src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"]
}
