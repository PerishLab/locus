#!/usr/bin/env sh
# runseal init hook: generated by runseal :init
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"

branch=$(git symbolic-ref --quiet --short HEAD || true)
if [ "$branch" = "main" ]; then
  printf '%s\n' "runseal pre-commit: refusing to commit directly on main" >&2
  printf '%s\n' "create a feature branch first, then commit again" >&2
  exit 1
fi

plumb doctor .
cargo fmt --all --check
cargo clippy --locked --workspace --all-targets -- -D warnings
cargo check --locked --workspace --all-targets --release
cargo test --locked --workspace
ectropy .
